# Local development only. Copy to server/.env (ignored by Git).
# The environment file is not served by the HTTP server.
JEV_ENABLED=0
PORT=8787
JEV_PUBLIC_ORIGIN=http://127.0.0.1:8787
TYPESAFE_API_KEY=
# A separate random secret, at least 32 characters. Never use the TypeSafe key here.
JEV_ACCESS_TOKEN=
